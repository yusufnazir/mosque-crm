<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="196-make-join-request-email-optional" author="mosque-crm">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="join_requests"/>
            <columnExists tableName="join_requests" columnName="email"/>
        </preConditions>
        <comment>
            Members may apply without an email address. In that case the phone number is used
            as their login identifier, so the column must accept NULL.
        </comment>
        <dropNotNullConstraint tableName="join_requests"
                               columnName="email"
                               columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
