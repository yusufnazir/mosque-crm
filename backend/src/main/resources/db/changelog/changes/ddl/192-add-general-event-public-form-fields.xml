<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="a9c1e2f3-0192-0001-general-event-public-form" author="mosque-crm">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="org_general_events"/>
            <not><columnExists tableName="org_general_events" columnName="public_form_show_phone"/></not>
        </preConditions>
        <addColumn tableName="org_general_events">
            <column name="public_form_show_phone" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="public_form_show_party_size" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="public_form_show_special_requests" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
